# Copy to .env and fill in local values. Never commit .env.
#
#   cp .env.example .env
#   openssl rand -base64 32   # -> BETTER_AUTH_SECRET
#
# All data in this prototype is synthetic. No external services are used.

# File-backed SQLite database used by Prisma (path relative to prisma/schema.prisma).
DATABASE_URL="file:./dev.db"

# Session signing secret for better-auth (>= 32 random characters).
BETTER_AUTH_SECRET="replace-with-32-plus-random-characters"

# Public origin of the app. Used for cookie settings and trusted-origin (CSRF) checks.
BETTER_AUTH_URL="http://localhost:3000"

# Demo passwords for the seeded accounts (required by `npm run db:seed`).
# Pick any values >= 8 characters; they are hashed before storage.
SEED_PASSWORD_ALEX="replace-me-alex"
SEED_PASSWORD_SAM="replace-me-sam"
SEED_PASSWORD_TAYLOR="replace-me-taylor"
